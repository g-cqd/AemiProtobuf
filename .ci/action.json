{
  "swift": {
    "sanitizerSkips": {
      "address": [
        "deeply nested input is refused at the limit"
      ]
    }
  },
  "quality": {
    "include": [
      "/Package.swift",
      "Sources/**",
      "Tests/**",
      "Plugins/**",
      "Benchmarks/**",
      "Conformance/**"
    ],
    "analyzers": [
      "deadwood",
      "dolly",
      "arcleak",
      "fcheck"
    ]
  },
  "commands": [
    {
      "id": "coverage-floor",
      "run": "AEMIPROTOBUF_COVERAGE_REUSE=1 Scripts/quality.sh coverage",
      "after": "macos-debug",
      "title": "Coverage · Enforce Floors"
    },
    {
      "id": "nio",
      "run": "AEMIPROTOBUF_NIO=1 swift test --filter AemiProtobufNIOTests",
      "after": "macos-debug",
      "title": "Integration · SwiftNIO"
    },
    {
      "id": "docs",
      "run": "Scripts/quality.sh docs",
      "os": "macOS",
      "cadence": [
        "nightly",
        "dispatch",
        "tag"
      ],
      "title": "Documentation · Build & Validate"
    }
  ],
  "scheduledMaxCommitAgeHours": 168
}
